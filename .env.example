APP_NAME=VakilNiti
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://vakilniti.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. On Hostinger use MySQL on 127.0.0.1:3306.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true on the live site (HTTPS only).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Court data provider: mock, supreme_court_website or ecourts_district_services.
COURT_DATA_DEFAULT_PROVIDER=mock

# Sign-in and sign-up codes by email (MSG91 Email). The sending domain must be verified in MSG91, and the
# template (its ID / unique name) must contain ##otp## (it may also use ##company_name##, ##name## and ##minutes##).
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=VakilNiti
MSG91_EMAIL_OTP_TEMPLATE=

# Never set to true on the live site.
OTP_BYPASS_ENABLED=false
# Account emails that may skip the emailed code while OTP_BYPASS_ENABLED is on (comma separated). Empty = nobody.
OTP_BYPASS_EMAILS=
# Mobile numbers that may skip the emailed code (Forgot password with a mobile number) while OTP_BYPASS_ENABLED is on. Empty = nobody.
OTP_BYPASS_NUMBERS=

# data.gov.in key, needed only to refresh cities online (locations:import-cities without --from-file).
DATA_GOV_IN_API_KEY=

# Optional. When set, the "Get the app" page shows store badges.
PLAY_STORE_URL=
APP_STORE_URL=

# Mobile numbers (comma separated) told in the bell each morning when the site logged errors.
ERROR_ALERT_MOBILES=

# Push notifications for alerts: run `php artisan webpush:keys` once and paste both lines here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
