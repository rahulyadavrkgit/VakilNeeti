# Environment files and secrets
.env
.env.*
!.env.example
/auth.json
**/credentials.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Dependencies
/vendor/
/node_modules/

# Local databases and database dumps
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.sql
**/*.dump

# Laravel runtime files (storage/ and bootstrap/cache/ use their own nested .gitignore files)
/storage/*.key
/storage/pail
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Test and coverage output
/.phpunit.cache
.phpunit.result.cache
**/coverage/
**/build/

# Tooling and IDE
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml
/.codex
/.cursor/
/.idea/
/.nova
/.vscode/
/.zed
**/.DS_Store
**/Thumbs.db
desktop.ini

# Logs and temporary files
**/*.log
**/*.tmp
**/*.bak
